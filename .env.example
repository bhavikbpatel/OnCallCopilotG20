# Copy to .env and fill in. .env is git-ignored.
OPENAI_API_KEY=
# OpenRouter key (sk-or-...): set https://openrouter.ai/api/v1 and keep model ids like openai/gpt-4.1.
# Direct OpenAI key: leave empty and use model ids like gpt-4.1 in config/app.yaml.
OPENAI_BASE_URL=
# Postgres for checkpointer + store; leave empty for in-memory (dev only). Needed for memory: playbook and
# `python -m copilot.reflexion freeze/load`. e.g. postgresql://oncall:<password>@localhost:5432/oncall
POSTGRES_DSN=
# Only for compose.postgres.yaml: the password the container creates the oncall user with.
# Keep it commented out otherwise: docker compose reads this file too, and an empty value replaces the
# shop database's own password, so astronomy-db never starts and the shop never comes up.
# POSTGRES_PASSWORD=
# MCP server URLs (defaults in config/mcp_servers.yaml)
MCP_TELEMETRY_URL=
MCP_RUNBOOKS_URL=
MCP_TICKETS_URL=
MCP_OPS_URL=
# Approval tokens: same value for the agent, the runner and every MCP server (mcp_servers/README.md).
# Required by docker compose. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_SECRET=
# Serve copilot/metrics.py on this port for Prometheus (eval runner, agent). Empty = off.
COPILOT_METRICS_PORT=
# LangSmith tracing (copilot/tracing.py): every LLM and tool call, with secrets and PII masked first.
# Off unless LANGSMITH_TRACING=true and a key (smith.langchain.com -> Settings -> API Keys) are set.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=oncall-copilot
