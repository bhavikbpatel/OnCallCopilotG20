# Loaded after the shop's .env and .env.override (compose.yaml, compose.lite.yaml, start.sh).
# The shop's .env says DEMO_VERSION=latest, which is a newer release than the 3.1.0 submodule:
# different images, different tools inside them (the 3.1.0 recommendation image has nc, not bash).
# Pin the images to the release the compose files, cases and SHOP_VERSION are written for.
DEMO_VERSION=3.1.0
