# Loaded after the shop's .env and .env.override by compose.yaml and compose.lite.yaml only.
# The shop's .env says DEMO_VERSION=latest, which is a newer release than the 3.1.0 submodule:
# different images, different tools inside them (the 3.1.0 recommendation image has nc, not bash).
# shop/astronomy/start.sh does not load this file: the dev and held-out eval runs use it on the
# shop's own DEMO_VERSION, and the system under test must not change between them.
DEMO_VERSION=3.1.0
