{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "A shop-changing action, e.g. set_flag(paymentFailure, off).",
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        }
      },
      "required": [
        "tool"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionPattern": {
      "additionalProperties": false,
      "description": "Matches any action with this tool whose args include every arg given here.\n\n``{tool: restart_service}`` matches every restart; ``{tool: restart_service, args:\n{service: payment}}`` matches only restarting payment.",
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        }
      },
      "required": [
        "tool"
      ],
      "title": "ActionPattern",
      "type": "object"
    },
    "AlertSpec": {
      "additionalProperties": false,
      "description": "The alert expected to open the incident. Names must match the Prometheus rules.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "provisional": {
          "default": true,
          "title": "Provisional",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "service"
      ],
      "title": "AlertSpec",
      "type": "object"
    },
    "Expected": {
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "incident",
            "noise"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "root_causes": {
          "items": {
            "$ref": "#/$defs/RootCause"
          },
          "title": "Root Causes",
          "type": "array"
        },
        "correct_actions": {
          "items": {
            "items": {
              "$ref": "#/$defs/Action"
            },
            "type": "array"
          },
          "title": "Correct Actions",
          "type": "array"
        },
        "acceptable_actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "title": "Acceptable Actions",
          "type": "array"
        },
        "forbidden_actions": {
          "items": {
            "$ref": "#/$defs/ActionPattern"
          },
          "title": "Forbidden Actions",
          "type": "array"
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity": {
          "$ref": "#/$defs/SeverityExpectation"
        }
      },
      "required": [
        "verdict",
        "severity"
      ],
      "title": "Expected",
      "type": "object"
    },
    "FaultSpec": {
      "additionalProperties": false,
      "properties": {
        "flag": {
          "title": "Flag",
          "type": "string"
        },
        "variant": {
          "title": "Variant",
          "type": "string"
        },
        "start_after_s": {
          "default": 0,
          "minimum": 0,
          "title": "Start After S",
          "type": "integer"
        },
        "mode": {
          "default": "steady",
          "enum": [
            "steady",
            "intermittent"
          ],
          "title": "Mode",
          "type": "string"
        },
        "on_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On S"
        },
        "off_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Off S"
        }
      },
      "required": [
        "flag",
        "variant"
      ],
      "title": "FaultSpec",
      "type": "object"
    },
    "LoadSpec": {
      "additionalProperties": false,
      "description": "normal = default Locust traffic; flood = loadGeneratorFloodHomepage on.",
      "properties": {
        "profile": {
          "default": "normal",
          "enum": [
            "normal",
            "flood"
          ],
          "title": "Profile",
          "type": "string"
        },
        "flood_start_after_s": {
          "default": 0,
          "minimum": 0,
          "title": "Flood Start After S",
          "type": "integer"
        },
        "flood_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flood Duration S"
        }
      },
      "title": "LoadSpec",
      "type": "object"
    },
    "RecoveryCheck": {
      "additionalProperties": false,
      "description": "Checked independently by the harness, never taken from the agent.\n\n``signal`` is a named signal from eval/telemetry/signals.py. Two ways to judge:\n\n- ``measure: window`` (default): the signal's value ``within_s`` after the fix,\n  compared either with a fixed ``threshold`` or with ``baseline_factor`` times\n  the value the runner measured just before injecting. Use the baseline form\n  for latency and memory: healthy levels differ a lot between sessions\n  (ad p95 was 7.6 ms in one run and 88 ms in another).\n- ``measure: since_fix``: errors/rates counted from ``settle_s`` after the fix\n  until ``within_s`` after it. Use this on low-traffic paths (checkout sees\n  ~2.5 requests/min) and for rare operations (cartFailure breaks only EmptyCart).\n  ``settle_s`` skips errors that happened before the fix but arrive late\n  (metrics reach Prometheus 60-120 s behind).",
      "properties": {
        "signal": {
          "enum": [
            "error_rate",
            "error_count",
            "latency_p95_ms",
            "latency_p50_ms",
            "throughput_rps",
            "memory_mb",
            "cpu_percent",
            "consumer_lag"
          ],
          "title": "Signal",
          "type": "string"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "measure": {
          "default": "window",
          "enum": [
            "window",
            "since_fix"
          ],
          "title": "Measure",
          "type": "string"
        },
        "op": {
          "default": "lt",
          "enum": [
            "lt",
            "gt"
          ],
          "title": "Op",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "baseline_factor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Factor"
        },
        "within_s": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Within S",
          "type": "integer"
        },
        "settle_s": {
          "default": 90,
          "minimum": 0,
          "title": "Settle S",
          "type": "integer"
        }
      },
      "required": [
        "signal",
        "service"
      ],
      "title": "RecoveryCheck",
      "type": "object"
    },
    "RootCause": {
      "additionalProperties": false,
      "properties": {
        "service": {
          "title": "Service",
          "type": "string"
        },
        "fault_type": {
          "title": "Fault Type",
          "type": "string"
        }
      },
      "required": [
        "service",
        "fault_type"
      ],
      "title": "RootCause",
      "type": "object"
    },
    "SeverityExpectation": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "SEV-1",
            "SEV-2",
            "SEV-3",
            "SEV-4",
            "NONE"
          ],
          "title": "Level",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "provisional": {
          "default": true,
          "title": "Provisional",
          "type": "boolean"
        }
      },
      "required": [
        "level"
      ],
      "title": "SeverityExpectation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "pattern": "^[DH]-\\d{3}$",
      "title": "Case Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "scenario_group": {
      "title": "Scenario Group",
      "type": "string"
    },
    "split": {
      "enum": [
        "dev",
        "heldout"
      ],
      "title": "Split",
      "type": "string"
    },
    "written_on": {
      "format": "date",
      "title": "Written On",
      "type": "string"
    },
    "written_by": {
      "default": "Person 4",
      "title": "Written By",
      "type": "string"
    },
    "faults": {
      "items": {
        "$ref": "#/$defs/FaultSpec"
      },
      "title": "Faults",
      "type": "array"
    },
    "load": {
      "$ref": "#/$defs/LoadSpec"
    },
    "alert": {
      "$ref": "#/$defs/AlertSpec"
    },
    "expected": {
      "$ref": "#/$defs/Expected"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "needs_verification": {
      "items": {
        "type": "string"
      },
      "title": "Needs Verification",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "title",
    "scenario_group",
    "split",
    "written_on",
    "alert",
    "expected"
  ],
  "title": "Case",
  "type": "object"
}
