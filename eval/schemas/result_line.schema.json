{
  "$defs": {
    "Approval": {
      "additionalProperties": true,
      "description": "One approval-gate decision (Person 2: ApprovalRecord / ApprovalDecision).",
      "properties": {
        "payload_hash": {
          "title": "Payload Hash",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approve",
            "edit",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "decided_by": {
          "default": "auto",
          "title": "Decided By",
          "type": "string"
        },
        "has_token": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Token"
        }
      },
      "required": [
        "payload_hash",
        "decision"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": true,
      "properties": {
        "max_tool_calls": {
          "exclusiveMinimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "max_tool_calls"
      ],
      "title": "Budget",
      "type": "object"
    },
    "Cost": {
      "additionalProperties": true,
      "properties": {
        "tokens_in": {
          "default": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "tokens_total": {
          "default": 0,
          "title": "Tokens Total",
          "type": "integer"
        },
        "usd": {
          "default": 0.0,
          "title": "Usd",
          "type": "number"
        }
      },
      "title": "Cost",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": true,
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "fault_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fault Type"
        },
        "status": {
          "enum": [
            "open",
            "supported",
            "refuted"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "rank",
        "service",
        "status"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "ProposedAction": {
      "additionalProperties": true,
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "payload_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Hash"
        }
      },
      "required": [
        "tool"
      ],
      "title": "ProposedAction",
      "type": "object"
    },
    "RecoveryObservation": {
      "additionalProperties": false,
      "description": "Filled by the runner from Prometheus (eval/recovery), never by the agent.\n\n``recovered`` is None when recovery could not be judged (no data, too little\ntraffic, no baseline, Prometheus unreachable); ``reason`` then says why.\n\"No data\" is never counted as healthy.",
      "properties": {
        "checked": {
          "default": false,
          "title": "Checked",
          "type": "boolean"
        },
        "recovered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovered"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal"
        },
        "service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        },
        "measure": {
          "anyOf": [
            {
              "enum": [
                "window",
                "since_fix"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measure"
        },
        "op": {
          "anyOf": [
            {
              "enum": [
                "lt",
                "gt"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Op"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "errors": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Errors"
        },
        "requests": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requests"
        },
        "points": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Points",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        }
      },
      "title": "RecoveryObservation",
      "type": "object"
    },
    "SeverityResult": {
      "additionalProperties": true,
      "properties": {
        "level": {
          "enum": [
            "SEV1",
            "SEV2",
            "SEV3",
            "SEV4",
            "NONE"
          ],
          "title": "Level",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        }
      },
      "required": [
        "level"
      ],
      "title": "SeverityResult",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": true,
      "description": "One entry from Person 3's hooks log, including blocked calls.",
      "properties": {
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "agent_role": {
          "title": "Agent Role",
          "type": "string"
        },
        "server": {
          "title": "Server",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "kind": {
          "enum": [
            "read",
            "write"
          ],
          "title": "Kind",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "payload_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Hash"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "blocked": {
          "default": false,
          "title": "Blocked",
          "type": "boolean"
        },
        "block_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Reason"
        },
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "fix",
                "follow_up",
                "rollback"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "driver": {
          "anyOf": [
            {
              "enum": [
                "model",
                "code"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driver"
        }
      },
      "required": [
        "seq",
        "agent",
        "agent_role",
        "server",
        "tool",
        "kind",
        "ok"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": true,
      "properties": {
        "agent_claims_recovered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Claims Recovered"
        },
        "rolled_back": {
          "default": false,
          "title": "Rolled Back",
          "type": "boolean"
        }
      },
      "title": "Verification",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "config_id": {
      "title": "Config Id",
      "type": "string"
    },
    "repeat": {
      "default": 1,
      "minimum": 1,
      "title": "Repeat",
      "type": "integer"
    },
    "agent_version": {
      "default": "unknown",
      "title": "Agent Version",
      "type": "string"
    },
    "config_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Hash"
    },
    "status": {
      "enum": [
        "completed",
        "budget_exhausted",
        "timeout",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "verdict": {
      "enum": [
        "incident",
        "noise",
        "undetermined"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "final_status": {
      "anyOf": [
        {
          "enum": [
            "recovered",
            "rolled_back",
            "escalated",
            "noise"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Status"
    },
    "escalation_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Escalation Reason"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "severity": {
      "anyOf": [
        {
          "$ref": "#/$defs/SeverityResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "proposed_actions": {
      "items": {
        "$ref": "#/$defs/ProposedAction"
      },
      "title": "Proposed Actions",
      "type": "array"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    },
    "replans": {
      "default": 0,
      "title": "Replans",
      "type": "integer"
    },
    "lessons_used": {
      "items": {
        "type": "string"
      },
      "title": "Lessons Used",
      "type": "array"
    },
    "lessons_rejected": {
      "items": {
        "type": "string"
      },
      "title": "Lessons Rejected",
      "type": "array"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "approvals": {
      "items": {
        "$ref": "#/$defs/Approval"
      },
      "title": "Approvals",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "cost": {
      "$ref": "#/$defs/Cost"
    },
    "recovery": {
      "$ref": "#/$defs/RecoveryObservation"
    },
    "agent_texts": {
      "items": {
        "type": "string"
      },
      "title": "Agent Texts",
      "type": "array"
    },
    "attack_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attack Id"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "config_id",
    "status",
    "started_at",
    "ended_at",
    "verdict",
    "budget"
  ],
  "title": "ResultLine",
  "type": "object"
}
