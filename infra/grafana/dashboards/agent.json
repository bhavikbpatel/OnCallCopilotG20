{
  "uid": "copilot-agent",
  "title": "On-Call Copilot: agent",
  "tags": [
    "copilot"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "15s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Runs by final status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum by (final_status) (increase(copilot_incidents_total[$__range]))",
          "legendFormat": "{{final_status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Task success",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum(increase(copilot_task_success_total{success=\"true\"}[$__range])) / sum(increase(copilot_task_success_total[$__range]))",
          "legendFormat": "success",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Rollbacks",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum(increase(copilot_rollbacks_total[$__range]))",
          "legendFormat": "rollbacks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Harmful actions",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "Target is zero",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum(increase(copilot_harmful_actions_total[$__range]))",
          "legendFormat": "harmful",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Cost per run",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum(increase(copilot_llm_cost_usd_total[$__range])) / clamp_min(sum(increase(copilot_incidents_total[$__range])), 1)",
          "legendFormat": "USD",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Checkout error rate (shop)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"checkout\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum(rate(traces_span_metrics_calls_total{service_name=\"checkout\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
          "legendFormat": "checkout",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "title": "Run duration (alert to end)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(copilot_incident_duration_seconds_bucket[$__range])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(copilot_incident_duration_seconds_bucket[$__range])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Time to recover",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "Runs the runner's independent check saw recover",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(copilot_time_to_recover_seconds_bucket[$__range])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(copilot_time_to_recover_seconds_bucket[$__range])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Tool calls per run",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(copilot_tool_calls_per_incident_bucket[$__range])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(copilot_tool_calls_per_incident_bucket[$__range])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Tool calls by role",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum by (agent_role, kind) (increase(copilot_tool_calls_total[5m]))",
          "legendFormat": "{{agent_role}} {{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Calls blocked by hooks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum by (reason) (increase(copilot_tool_calls_blocked_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Errors and timeouts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum by (status) (increase(copilot_incidents_total{status=~\"error|timeout|budget_exhausted\"}[15m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum by (tool) (increase(copilot_tool_calls_total{outcome=\"error\"}[15m]))",
          "legendFormat": "tool error {{tool}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Actions executed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum by (tool, purpose) (increase(copilot_actions_total[15m]))",
          "legendFormat": "{{tool}} ({{purpose}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "LLM spend",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "sum by (config_id) (increase(copilot_llm_cost_usd_total[15m]))",
          "legendFormat": "{{config_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
