    {
      "lesson_id": "L-D-012-017",
      "text": "When product-catalog p95 latency is elevated and the lock-contention flag changed recently, do not refute lock contention solely because server error rate is flat or because the flag change followed the alert; latency-dominant contention can lack an error surge, so use the flag signal and verify whether disabling it restores latency.",
      "preconditions": [
        {
          "check": "promql_above",
          "args": {
            "query": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"product-catalog\",span_kind=\"SPAN_KIND_SERVER\"}[5m])))",
            "threshold": 1000
          }
        },
        {
          "check": "recent_change",
          "args": {
            "flag": "productCatalogLockContention",
            "within": "30m"
          }
        }
      ],
      "service": "product-catalog",
      "fault_family": "productCatalogLockContention",
      "source_incident": "DEV-C2-D-012-r1-20261104T174839Z",
      "reviewed_by": "Rohit",
      "status": "active"
    },
    {
      "lesson_id": "L-D-013-010",
      "text": "When product-catalog errors are elevated after the productCatalogFailure flag is turned on, do not dismiss the flag as causal solely because the error-rate rise appears to precede the recorded flip; direct traces naming the flag identify the cause, so restore the flag to off instead of taking no action or restarting the service.",
      "preconditions": [
        {
          "check": "recent_change",
          "args": {
            "flag": "productCatalogFailure",
            "within": "30m"
          }
        },
        {
          "check": "promql_above",
          "args": {
            "query": "(sum(rate(traces_span_metrics_calls_total{service_name=\"product-catalog\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m])) or vector(0)) / sum(rate(traces_span_metrics_calls_total{service_name=\"product-catalog\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
            "threshold": 0.02
          }
        }
      ],
      "service": "product-catalog",
      "fault_family": "productCatalogFailure",
      "source_incident": "DEV-C2-D-013-r1-20261104T180022Z",
      "reviewed_by": "Rohit",
      "status": "active"
    },
