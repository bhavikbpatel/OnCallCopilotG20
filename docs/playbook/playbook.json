  "lessons": [
    {
      "lesson_id": "L-D-001-001",
      "text": "When checkout errors are elevated and payment server errors are elevated too, identify payment as the likely originating service rather than ranking checkout as the root cause; checkout may only be reporting the propagated failure.",
      "preconditions": [
        {
          "check": "promql_above",
          "args": {
            "query": "(sum(rate(traces_span_metrics_calls_total{service_name=\"payment\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m])) or vector(0)) / sum(rate(traces_span_metrics_calls_total{service_name=\"payment\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
            "threshold": 0.05
          }
        },
        {
          "check": "promql_above",
          "args": {
            "query": "(sum(rate(traces_span_metrics_calls_total{service_name=\"checkout\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m])) or vector(0)) / sum(rate(traces_span_metrics_calls_total{service_name=\"checkout\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
            "threshold": 0.05
          }
        }
      ],
      "service": "payment",
      "fault_family": "paymentFailure",
      "source_incident": "DEV-C2-D-001-r1-20261104T153515Z",
      "reviewed_by": "Rohit",
      "status": "active"
    },
    {
      "lesson_id": "L-D-004-003",
      "text": "When cart errors are elevated soon after a cartFailure flag change, do not dismiss the rollout merely because Redis errors are also present or flag-evaluation errors seem common; treat the flag change as a leading cause and disable the flag rather than restarting cart or valkey-cart.",
      "preconditions": [
        {
          "check": "recent_change",
          "args": {
            "flag": "cartFailure",
            "within": "30m"
          }
        },
        {
          "check": "promql_above",
          "args": {
            "query": "sum(increase(traces_span_metrics_calls_total{service_name=\"cart\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m])) or vector(0)",
            "threshold": 1
          }
        }
      ],
      "service": "cart",
      "fault_family": "cartFailure",
      "source_incident": "DEV-C2-D-004-r1-20261104T160519Z",
      "reviewed_by": "Rohit",
      "status": "active"
    },
    {
      "lesson_id": "L-D-006-005",
      "text": "When `imageSlowLoad` has changed recently and frontend-proxy p95 latency is high, do not rule out the fault solely because image-provider server spans are fast; disable the flag, since the added delay may not appear in provider spans.",
      "preconditions": [
        {
          "check": "recent_change",
          "args": {
            "flag": "imageSlowLoad",
            "within": "30m"
          }
        },
        {
          "check": "promql_above",
          "args": {
            "query": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"frontend-proxy\",span_kind=\"SPAN_KIND_SERVER\"}[5m])))",
            "threshold": 1000
          }
        }
      ],
      "service": "image-provider",
      "fault_family": "feature_flag",
      "source_incident": "DEV-C2-D-006-r1-20261104T163221Z",
      "reviewed_by": "Rohit",
      "status": "active"
    },
    {
      "lesson_id": "L-D-009-007",
      "text": "When the emailMemoryLeak flag changed recently and email memory is still above its alert threshold, do not dismiss the leak hypothesis just because the alert began seconds before the rollout; disable the flag instead of escalating without a corrective action.",
      "preconditions": [
        {
          "check": "recent_change",
          "args": {
            "flag": "emailMemoryLeak",
            "within": "30m"
          }
        },
        {
          "check": "promql_above",
          "args": {
            "query": "sum(container_memory_usage_total_bytes{container_name=\"email\"}) / 1e6",
            "threshold": 80
          }
        }
      ],
      "service": "email",
      "fault_family": "memory_leak",
      "source_incident": "DEV-C2-D-009-r1-20261104T170610Z",
      "reviewed_by": "Rohit",
      "status": "active"
    },
    {
      "lesson_id": "L-D-011-008",
      "text": "When checkout errors are elevated after a recent change to `paymentUnreachable`, treat that flag\u2014not the payment service\u2014as the likely cause and target that exact flag; do not disable the similarly named `paymentFailure` flag.",
